{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleDetection": "force"
    },
    "include": [
        "solution.ts",
        "Assignment-*/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}